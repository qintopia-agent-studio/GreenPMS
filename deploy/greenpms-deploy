#!/usr/bin/python3
"""Root-owned fixed entry. Root CLI also supports adoption/recovery in runbook."""
import os
import sys

if os.environ.get("SUDO_USER") == "greenpms-deploy" and sys.argv[1:2] not in (["deploy"], ["rollback"], ["maintenance"]):
    sys.exit("administrator operation is not allowed to deployment identity")

os.execve("/opt/greenpms-release/venv/bin/python3",
          ["python3", "-I", "/opt/greenpms-release/entry.py", *sys.argv[1:]],
          {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "LANG": "C.UTF-8"})
